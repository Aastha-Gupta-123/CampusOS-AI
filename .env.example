# =============================================================================
# CampusMate AI - Environment Variables
# Copy this file to `.env` and fill in your values before running.
# DO NOT commit the `.env` file to version control.
# =============================================================================

# ── AI Configuration ───────────────────────────────────────────────────
# Groq API Key (optional) - get at https://console.groq.com
# Free models: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
GROQ_MAX_TOKENS=4096

# ── Database ───────────────────────────────────────────────────────────
# SQLite (default - no setup needed)
DATABASE_URL=sqlite:///backend/database/campus_agent.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/campusmate

# ── JWT Authentication ─────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=campusmate-secret-key-change-in-production
JWT_EXPIRE_DAYS=7

# ── CORS & URLs ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# FRONTEND_URL=https://campusmate-ai.vercel.app
# CORS_ORIGINS=https://campusmate-ai.vercel.app

# ── Server ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ── Frontend (Vite build-time variable) ───────────────────────────────
# Local dev:
VITE_API_URL=http://127.0.0.1:8000
# Production (replace with your deployed backend URL):
# VITE_API_URL=https://campusmate-backend.onrender.com
# VITE_API_URL=https://campusmate-backend.up.railway.app
