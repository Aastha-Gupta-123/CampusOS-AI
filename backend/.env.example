# Example environment variables for the backend
# Copy this file to `.env` and fill values before running the server.

# Gemini (Google Generative AI) API key. Do NOT commit your real key.
GEMINI_API_KEY=

# Optional: override the SQLite DB path. Defaults to backend/database/campus_agent.db
# Example: DATABASE_URL=sqlite:///C:/path/to/campus_agent.db
DATABASE_URL=
